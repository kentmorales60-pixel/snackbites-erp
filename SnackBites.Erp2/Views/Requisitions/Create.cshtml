@model SnackBites.Erp2.Models.RequisitionCreateViewModel
@{ ViewBag.Title = "New Requisition"; }

<main>
    <div class="page-header">
        <h2>New Item Requisition</h2>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group" style="max-width:320px;">
            <label>Department</label>
            @Html.EnumDropDownListFor(m => m.Department, new { @class = "form-control" })
        </div>

        <table class="table table-bordered">
            <thead>
                <tr><th>Item</th><th>Quantity</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Lines.Count; i++)
                {
                    <tr>
                        <td>
                            @Html.DropDownListFor(m => m.Lines[i].ItemId, (SelectList)ViewBag.Items,
                                "-- select item --", new { @class = "form-control" })
                        </td>
                        <td>
                            @Html.TextBoxFor(m => m.Lines[i].Qty,
                                new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="page-actions">
            <button type="submit" class="btn btn-primary">Submit Requisition</button>
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</main>